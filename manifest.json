{
    "manifest_version": 3,
    "name": "My First Extension",
    "version": "1.0",
    "description": "This is my first Chrome extension.",
    "permissions": [
        "activeTab"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}